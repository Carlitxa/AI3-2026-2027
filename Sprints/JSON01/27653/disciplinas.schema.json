{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "curso": {
      "type": "string"
    },
    "disciplina": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "ano": {
            "type": "integer"
          },
          "teorica": {
            "type": "object",
            "properties": {
              "horas": {
                "type": "integer"
              },
              "nome": {
                "type": "string"
              }
            },
            "required": [
              "horas",
              "nome"
            ]
          },
          "pratica": {
            "type": "object",
            "properties": {
              "horas": {
                "type": "integer"
              },
              "nome": {
                "type": "string"
              }
            },
            "required": [
              "horas",
              "nome"
            ]
          }
        },
        "required": [
          "codigo",
          "nome",
          "teorica"
        ]
      }
    }
  },
  "required": [
    "curso",
    "disciplina"
  ]
}